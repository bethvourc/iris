#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]:-$0}"
ROOT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"

export IRIS_PROJECT_ROOT="$ROOT_DIR"
export PYTHONPATH="$ROOT_DIR/src${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONDONTWRITEBYTECODE=1

PYTHON="$ROOT_DIR/.venv/bin/python"

if [[ ! -x "$PYTHON" ]]; then
  echo "Iris environment is missing. Run: uv sync --dev --no-editable" >&2
  exit 1
fi

exec "$PYTHON" -S "$ROOT_DIR/src/iris/bootstrap.py" "$@"
