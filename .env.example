# Required for OpenAI Realtime, Responses, and computer-use.
UV_NO_EDITABLE=1
OPENAI_API_KEY=

# Required for Google Cloud Vision OCR/labels.
# Example: /Users/you/.config/gcloud/iris-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=

IRIS_AGENT_NAME=Iris
IRIS_VOICE=marin
IRIS_TOGGLE_HOTKEY=<ctrl>+<space>
IRIS_KILL_HOTKEY=<ctrl>+<alt>+k

IRIS_REALTIME_MODEL=gpt-realtime-2
IRIS_CHAT_MODEL=gpt-5.5
IRIS_VISION_MODEL=gpt-5.5
IRIS_COMPUTER_USE_MODEL=computer-use-preview
IRIS_COMPUTER_USE_ENVIRONMENT=browser
GROQ_API_KEY=
IRIS_FAST_INTENT_MODEL=compound-mini
IRIS_STT_MODEL=whisper-large-v3-turbo
IRIS_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
IRIS_SCREENSHOT_INTERVAL_SECONDS=0.5
IRIS_GATEWAY_TOKEN=
IRIS_STATE_DB=build/iris.sqlite3
IRIS_AUTONOMY_LEVEL=L1
IRIS_MEETING_CONSENT_REQUIRED=true
IRIS_MEETING_RETENTION_DAYS=30
IRIS_LISTEN_SECONDS=2.0
IRIS_WAKE_POLL_SECONDS=1.2
IRIS_WAKE_WORDS=iris,hey iris
IRIS_BARGE_IN_ENABLED=true
IRIS_BARGE_IN_GRACE_MS=250
IRIS_ECHO_SUPPRESSION_MS=800
# Only controls terminal fallback output through macOS `say`.
# Live `./iris start --live` speech-to-speech still speaks through Realtime.
IRIS_SPEAK_RESPONSES=false
IRIS_MAX_RESPONSE_CHARS=220

# Terminal-first phone push. Pushover is the v1 default. ntfy is still supported.
IRIS_NOTIFY_PROVIDER=pushover
PUSHOVER_TOKEN=
PUSHOVER_USER=
IRIS_NTFY_SERVER=https://ntfy.sh
IRIS_NTFY_TOPIC=
IRIS_NTFY_TOKEN=
IRIS_NOTIFY_TIMEOUT_SECONDS=30

# Outbound email (Resend). Used for meeting recaps and the send_email tool.
IRIS_EMAIL_PROVIDER=resend
RESEND_API_KEY=
IRIS_EMAIL_FROM=
IRIS_EMAIL_TO=

# Advanced profile overrides. Most users should run `./iris setup` instead.
# IRIS_USER_NAME=
# IRIS_USER_FIRST_NAME=
# IRIS_USER_PRONOUNS=
