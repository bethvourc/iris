# Iris configuration template.
#
#   cp .env.example .env
#
# `.env` is git-ignored — never commit real keys. Only OPENAI_API_KEY is
# required; everything else has a working default or is an optional integration.

# --- Required ----------------------------------------------------------------
# OpenAI Realtime, Responses, and computer-use.
OPENAI_API_KEY=

# --- Local gateway -----------------------------------------------------------
# Bearer token for the local HTTP gateway (`./iris serve`). Generate one with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# The macOS app generates its own and keeps it in the Keychain.
IRIS_GATEWAY_TOKEN=
IRIS_STATE_DB=build/iris.sqlite3

# --- Optional integrations ---------------------------------------------------
# Google Cloud Vision OCR/labels. Path to a service-account JSON key, e.g.
#   /Users/you/.config/gcloud/iris-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=

# Groq, for low-latency speech-to-text and intent routing (falls back to OpenAI).
GROQ_API_KEY=
IRIS_FAST_INTENT_MODEL=compound-mini
IRIS_STT_MODEL=whisper-large-v3-turbo

# Phone push notifications: pushover (default) or ntfy.
IRIS_NOTIFY_PROVIDER=pushover
PUSHOVER_TOKEN=
PUSHOVER_USER=
IRIS_NTFY_SERVER=https://ntfy.sh
IRIS_NTFY_TOPIC=
IRIS_NTFY_TOKEN=
IRIS_NOTIFY_TIMEOUT_SECONDS=30

# Outbound email via Resend — meeting recaps and the send_email tool.
IRIS_EMAIL_PROVIDER=resend
RESEND_API_KEY=
IRIS_EMAIL_FROM=
IRIS_EMAIL_TO=

# --- Identity & hotkeys ------------------------------------------------------
IRIS_AGENT_NAME=Iris
IRIS_VOICE=marin
IRIS_TOGGLE_HOTKEY=<ctrl>+<space>
IRIS_KILL_HOTKEY=<ctrl>+<alt>+k

# --- Models ------------------------------------------------------------------
IRIS_REALTIME_MODEL=gpt-realtime-2
IRIS_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
IRIS_CHAT_MODEL=gpt-5.5
IRIS_VISION_MODEL=gpt-5.5
IRIS_COMPUTER_USE_MODEL=computer-use-preview
IRIS_COMPUTER_USE_ENVIRONMENT=browser
IRIS_EMBEDDING_MODEL=text-embedding-3-small

# --- Memory ------------------------------------------------------------------
IRIS_MEMORY_EMBEDDINGS_ENABLED=true
# local = deterministic offline vectors, openai = API embeddings,
# auto = OpenAI if configured, else local.
IRIS_MEMORY_EMBEDDING_PROVIDER=local

# --- Safety & privacy --------------------------------------------------------
IRIS_AUTONOMY_LEVEL=L1
IRIS_MEETING_CONSENT_REQUIRED=true
IRIS_MEETING_RETENTION_DAYS=30

# --- Voice & turn-taking -----------------------------------------------------
IRIS_WAKE_WORDS=iris,hey iris
IRIS_WAKE_POLL_SECONDS=1.2
IRIS_LISTEN_SECONDS=2.0
IRIS_SCREENSHOT_INTERVAL_SECONDS=0.5
IRIS_BARGE_IN_ENABLED=true
IRIS_BARGE_IN_GRACE_MS=250
IRIS_ECHO_SUPPRESSION_MS=800
IRIS_TURN_BUFFER_ENABLED=true
IRIS_TURN_CONTINUATION_MS=1200
IRIS_TURN_MAX_WAIT_MS=2500
IRIS_TURN_MIN_WORDS_FOR_IMMEDIATE_RESPONSE=4
IRIS_LIVE_VAD_SILENCE_MS=900
# Only controls terminal fallback output through macOS `say`.
# Live `./iris start --live` speech-to-speech always speaks through Realtime.
IRIS_SPEAK_RESPONSES=false
IRIS_MAX_RESPONSE_CHARS=220

# --- Profile overrides -------------------------------------------------------
# Most users should run `./iris setup` instead.
# IRIS_USER_NAME=
# IRIS_USER_FIRST_NAME=
# IRIS_USER_PRONOUNS=

# --- Tooling -----------------------------------------------------------------
UV_NO_EDITABLE=1
