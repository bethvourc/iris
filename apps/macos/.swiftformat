# SwiftFormat — run `swiftformat .` from apps/macos
--swiftversion 6.0
--indent 4
# SwiftLint forbids trailing commas; keep the tools agreeing.
--commas inline
--maxwidth 120
--wraparguments before-first
--wrapparameters before-first
--stripunusedargs closure-only
--self remove
--importgrouping testable-bottom
--exclude Iris.xcodeproj
